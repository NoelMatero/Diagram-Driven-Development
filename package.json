{
  "name": "board-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Diagram-driven development: an MCP server that gives Claude read/write access to Excalidraw diagrams that live in the repo, plus a live local board.",
  "type": "module",
  "scripts": {
    "mcp": "tsx src/mcp/server.ts",
    "board": "tsx scripts/board.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "postinstall": "node scripts/build-vendor.mjs && npm run build:viewer",
    "typecheck": "tsc --noEmit",
    "check:drift": "tsx scripts/check-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:board": "tsx scripts/e2e-live-board.mjs",
    "diagram:example": "tsx scripts/make-example-diagram.mjs",
    "diagram:render": "tsx scripts/render-diagram.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elkjs": "0.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.25.12",
    "fontkit": "^2.0.4",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
